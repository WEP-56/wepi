{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "WEPI",
  "version": "0.2.0",
  "identifier": "com.wepi.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{
      "label": "main",
      "title": "WEPI",
      "width": 1280,
      "height": 820,
      "minWidth": 800,
      "minHeight": 560,
      "decorations": false,
      "visible": true
    }],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico", "icons/icon.png"],
    "resources": {
      "extensions/": "extensions/"
    }
  }
}
